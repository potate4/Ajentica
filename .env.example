# =====================================================================
# Codebase Q&A Agent — environment configuration
# Copy to `.env` and fill in the values that apply to your setup.
# =====================================================================

# --- LLM (provider-agnostic, LiteLLM model strings) -------------------
# Examples (only one needs to be set, plus its API key below):
#   gemini/gemini-2.0-flash
#   openai/gpt-4o-mini
#   openrouter/anthropic/claude-3.5-sonnet
#   ollama/qwen2.5-coder:7b
#   groq/llama-3.1-70b-versatile
LLM_MODEL=openrouter/qwen3-235b-a22b-2507:nitro

# Optional: custom endpoint (OpenRouter, vLLM, local OpenAI-compatible)
# LLM_API_BASE=https://openrouter.ai/api/v1

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60

# --- API keys (set the one matching your LLM_MODEL provider) ----------
# LiteLLM picks these up automatically.
OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- Target repository to index ---------------------------------------
TARGET_REPO_URL=https://github.com/pallets/flask.git
TARGET_REPO_REF=main

# --- Retrieval tunables -----------------------------------------------
RETRIEVAL_TOP_K=5

# --- Agent shape (core: single; bonus: crew) --------------------------
AGENT_MODE=crew

# --- Bonus toggles (all ON — flip to false to disable individually) ---
ENABLE_STREAMING=true
ENABLE_REASONING_TRACE=true
ENABLE_SESSION_MEMORY=true
